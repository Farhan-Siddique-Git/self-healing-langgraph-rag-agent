# Copy this file to .env and adjust if needed. All of these have sensible
# defaults in app/config.py, so .env is optional for Stages 0-3.

OLLAMA_BASE_URL=http://localhost:11434
# qwen2.5:1.5b is faster but unreliable about calling tools (tested) — 7b is
# the validated default. Only drop to 1.5b if you're CPU-constrained.
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=policies

POLICIES_DIR=./data/policies
EMPLOYEES_CSV=./data/employees.csv

CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_TOOL_ITERATIONS=5

API_HOST=127.0.0.1
API_PORT=8000

# --- Stage 4 (optional): swappable LLM provider ------------------------------
# LLM_PROVIDER=ollama (default) or vllm — see app/llm.py.
# LLM_PROVIDER=ollama
# VLLM_BASE_URL=http://localhost:8001/v1
# VLLM_MODEL=Qwen/Qwen3-30B-A3B
# VLLM_API_KEY=

# --- Stage 4 (optional): Neo4j knowledge graph -------------------------------
# See app/graph_tool.py and scripts/ingest_graph.py.
# NEO4J_ENABLED=false
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=
